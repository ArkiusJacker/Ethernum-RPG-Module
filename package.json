{
  "name": "ethernum-rpg-module",
  "version": "3.8.2",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:manifest": "node tools/validate-release.mjs --manifest module.json --root .",
    "validate:dist": "node tools/validate-release.mjs --manifest dist/module.json --root dist --check-imports"
  },
  "devDependencies": {
    "@league-of-foundry-developers/foundry-vtt-types": "^12.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.0.0",
    "vite-plugin-static-copy": "^2.0.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "pdfjs-dist": "4.10.38"
  }
}
